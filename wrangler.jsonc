{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dem-qua",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // The PWA is served as static assets; only /api/* reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dem-qua",
      // Replace with the id printed by `npx wrangler d1 create dem-qua` before the first deploy.
      // Local dev and tests work with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "CLAUDE_MODEL": "claude-opus-5-5"
  },
  "observability": {
    "enabled": true
  }
}
